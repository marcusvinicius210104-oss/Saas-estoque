# Connection string do Postgres (Supabase, Neon, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Chave usada para assinar as sessoes de login. Gere a sua com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# Credenciais do administrador criado pelo `npm run db:seed`
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@flash.local"
ADMIN_PASSWORD="troque-esta-senha"
